                          },
                          "minItems": 1,
                          "title": "Resultids",
                          "type": "array"
                        },
                        "scanID": {
                          "minLength": 1,
                          "title": "Scanid",
                          "type": "string"
                        },
                        "scannerType": {
                          "minLength": 1,
                          "title": "Scannertype",
                          "type": "string"
                        }
                      },
                      "required": [
                        "scanID",
                        "scannerType",
                        "resultIDs"
                      ],
                      "title": "TriageV2SelectionRow",
                      "type": "object"
                    },
                    "minItems": 1,
                    "title": "Selection",
                    "type": "array"
                  }
                },
                "required": [
                  "projectID",
                  "selection"
                ],
                "title": "TriageV2Request",
                "type": "object"
              }
            }
          },
          "required": true
