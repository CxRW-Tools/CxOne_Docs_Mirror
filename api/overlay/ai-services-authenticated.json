                      "type": "boolean"
                    },
                    "selection": {
                      "items": {
                        "properties": {
                          "adopted": {
                            "default": 0,
                            "title": "Adopted",
                            "type": "integer"
                          },
                          "groups": {
                            "default": 0,
                            "title": "Groups",
                            "type": "integer"
                          },
                          "published": {
                            "default": 0,
                            "title": "Published",
                            "type": "integer"
                          },
                          "scanID": {
                            "title": "Scanid",
                            "type": "string"
                          },
                          "scannerType": {
                            "title": "Scannertype",
                            "type": "string"
                          },
                          "triageId": {
                            "title": "Triageid",
                            "type": "string"
                          }
                        },
                        "required": [
                          "scanID",
                          "scannerType",
                          "triageId"
                        ],
                        "title": "TriageV2SelectionOutcomeRow",
                        "type": "object"
                      },
                      "title": "Selection",
                      "type": "array"
                    },
                    "status": {
                      "default": "accepted",
                      "title": "Status",
                      "type": "string"
                    },
                    "triageJobId": {
                      "title": "Triagejobid",
                      "type": "string"
                    }
                  },
