    "/api/remediation/v2/remediate": {
      "post": {
        "operationId": "remediate_v2_v2_remediate_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-correlation-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Correlation-Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "POST /v2/remediate body \u2014 multi-scan bulk selection.",
                "properties": {
                  "projectID": {
                    "minLength": 1,
                    "title": "Projectid",
                    "type": "string"
                  },
                  "selection": {
                    "items": {
                      "description": "One (scan, engine) group in a v2 bulk selection.",
                      "properties": {
                        "resultIDs": {
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1,
                          "title": "Resultids",
                          "type": "array"
                        },
                        "scanID": {
                          "minLength": 1,
                          "title": "Scanid",
                          "type": "string"
                        },
                        "scannerType": {
                          "minLength": 1,
                          "title": "Scannertype",
                          "type": "string"
                        }
                      },
                      "required": [
                        "scanID",
                        "scannerType",
                        "resultIDs"
                      ],
                      "title": "SelectionSlice",
                      "type": "object"
                    },
                    "minItems": 1,
                    "title": "Selection",
                    "type": "array"
                  }
                },
                "required": [
                  "projectID",
                  "selection"
                ],
                "title": "RemediateV2Request",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "202 Accepted for POST /v2/remediate.",
                  "properties": {
                    "expectedTotal": {
                      "minimum": 0.0,
                      "title": "Expectedtotal",
                      "type": "integer"
                    },
                    "published": {
                      "default": true,
                      "title": "Published",
                      "type": "boolean"
                    },
                    "remediationJobId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "Remediationjobid"
                    },
                    "selection": {
                      "items": {
                        "description": "One selection entry with publish/adopt counts (replaces resultIDs).",
                        "properties": {
                          "adopted": {
                            "minimum": 0.0,
                            "title": "Adopted",
                            "type": "integer"
                          },
                          "published": {
                            "minimum": 0.0,
                            "title": "Published",
                            "type": "integer"
                          },
                          "scanID": {
                            "title": "Scanid",
                            "type": "string"
                          },
                          "scannerType": {
                            "title": "Scannertype",
                            "type": "string"
                          }
                        },
